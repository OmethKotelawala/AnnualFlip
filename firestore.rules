rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper authentication functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email in [
          "yutrytopipygh@gmail.com",
          "omethranhasacz@gmail.com",
          "colddoggy1@gmail.com",
          "admin@gmail.com",
          "admin@northbay.lk",
          "admin@flippage.com",
          "paneljoker145@gmail.com"
        ] ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*admin@.*')) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Users Collection (profiles, emails, trial duration, plan tiers)
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() || isAdmin();
      allow update, delete: if isOwner(userId) || isAdmin();
    }
    
    // Flipbook Publications Collection (Publicly readable for shared readers, write by owner/admin)
    match /publications/{pubId} {
      allow read: if true;
      allow create: if isAuthenticated() || isAdmin();
      allow update, delete: if (isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin())) || isAdmin();
    }
  }
}
