rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper authentication functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email in [
          "yutrytopipygh@gmail.com",
          "omethranhasacz@gmail.com",
          "colddoggy1@gmail.com",
          "admin@gmail.com",
          "admin@northbay.lk",
          "admin@flippage.com",
          "paneljoker145@gmail.com"
        ] ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*admin@.*')) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Users Collection (profiles, emails, trial duration, plan tiers)
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin() || isOwner(userId);
    }
    
    // Flipbook Publications Collection (Publicly readable for shared readers, write by owner/admin/workspace)
    match /publications/{pubId} {
      allow read: if true;
      allow create, update, write: if true;
      allow delete: if true;

      match /{subCollection=**} {
        allow read, write: if true;
      }
    }

    // Digital Books Collection (Publicly readable for 3D flipbook reader & backend sync)
    match /books/{bookId} {
      allow read, write: if true;

      match /{subCollection=**} {
        allow read, write: if true;
      }
    }

    // Global match for any supplementary collection
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
